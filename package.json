{
  "name": "yugioh-electron",
  "version": "0.1.0",
  "description": "Yu-Gi-Oh! Web-Desktop Duel Simulator (DM + GX Era)",
  "private": true,
  "type": "module",
  "main": "dist/main/index.js",
  "scripts": {
    "dev": "tsx scripts/dev.ts",
    "build": "tsx scripts/build.ts",
    "spike": "tsx tools/engine-spike/run.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "vue-tsc --noEmit",
    "download:cards": "tsx scripts/stub-download.ts",
    "rebuild:native": "electron-rebuild -f -w better-sqlite3"
  },
  "dependencies": {
    "ocgcore-wasm": "^0.1.2",
    "pinia": "^3.0.4",
    "vue": "^3.5.29",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@electron/rebuild": "^3.7.2",
    "@eslint/js": "^9.39.2",
    "@types/node": "^22.13.4",
    "@vitejs/plugin-vue": "^5.2.4",
    "cross-env": "^10.1.0",
    "concurrently": "^9.1.2",
    "electron": "^35.7.5",
    "electron-builder": "^26.0.2",
    "esbuild": "^0.25.0",
    "eslint": "^9.39.2",
    "eslint-plugin-vue": "^9.33.0",
    "prettier": "^3.6.2",
    "sass-embedded": "^1.97.3",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.26.0",
    "vite": "^6.2.0",
    "vue-tsc": "^2.2.8",
    "wait-on": "^8.0.4"
  }
}
