{
  "name": "yugioh-electron",
  "version": "0.1.1",
  "description": "Yu-Gi-Oh! Web-Desktop Duel Simulator (DM + GX Era)",
  "private": true,
  "type": "module",
  "main": "dist/main/index.js",
  "scripts": {
    "dev": "tsx scripts/dev.ts",
    "build": "tsx scripts/build.ts",
    "spike": "tsx tools/engine-spike/run.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "test": "tsx scripts/run-tests.ts",
    "generate:decks": "tsx scripts/generate-all-character-decks.ts",
    "build:cards": "tsx scripts/build-card-pool.ts",
    "download:cards": "tsx scripts/download-card-images.ts",
    "generate:videos": "tsx scripts/generate-character-videos.ts",
    "generate:icons": "tsx scripts/generate-icons.ts",
    "generate:audio": "tsx scripts/generate-audio-tracks.ts",
    "download:soundpack": "tsx scripts/download-soundpack.ts",
    "generate:manifest": "tsx scripts/generate-update-manifest.ts",
    "pack:assets": "bash scripts/pack-media-assets.sh",
    "package": "npm run build && electron-builder --dir",
    "package:mac": "npm run build && electron-builder --mac --dir",
    "dist": "npm run build && electron-builder",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:win": "npm run build && electron-builder --win",
    "dist:linux": "npm run build && electron-builder --linux",
    "rebuild:native": "electron-rebuild -f -w better-sqlite3"
  },
  "dependencies": {
    "@google/genai": "^2.17.1",
    "better-sqlite3": "^13.0.3",
    "electron-store": "^11.0.2",
    "ocgcore-wasm": "^0.1.2",
    "pinia": "^3.0.4",
    "vue": "^3.5.29",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@electron/rebuild": "^3.7.2",
    "@eslint/js": "^9.39.2",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.13.4",
    "@types/sharp": "^0.31.1",
    "@vitejs/plugin-vue": "^5.2.4",
    "concurrently": "^9.1.2",
    "cross-env": "^10.1.0",
    "electron": "^35.7.5",
    "electron-builder": "^26.0.2",
    "esbuild": "^0.25.0",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^9.33.0",
    "prettier": "^3.6.2",
    "sass": "^1.102.0",
    "sass-embedded": "^1.97.3",
    "sharp": "^0.35.3",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.26.0",
    "vite": "^6.2.0",
    "vue-tsc": "^2.2.8",
    "wait-on": "^8.0.4"
  }
}
